 /* wallust template - colors-rofi */

* {
active-background: #1E8EFF;
active-foreground: #B4E1FD;
normal-background: #0D1926;
normal-foreground: #B4E1FD;
urgent-background: #8E1EFF;
urgent-foreground: #B4E1FD;

alternate-active-background: #FF8E1E;
alternate-active-foreground: #B4E1FD;
alternate-normal-background: #0D1926;
alternate-normal-foreground: #B4E1FD;
alternate-urgent-background: #0D1926;
alternate-urgent-foreground: #B4E1FD;

selected-active-background: #1E8EFF;
selected-active-foreground: #000000;
selected-normal-background: #1E8EFF;
selected-normal-foreground: #000000;
selected-urgent-background: #1E8EFF;
selected-urgent-foreground: #000000;

background-color: #0D1926;
background: rgba(0,0,0,0.7);
foreground: #B4E1FD;
border-color: #1E8EFF;

color0: #363636;
color1: #FF0883;
color2: #83FF08;
color3: #FF8308;
color4: #0883FF;
color5: #8308FF;
color6: #08FF83;
color7: #B6B6B6;
color8: #424242;
color9: #FF1E8E;
color10: #8EFF1E;
color11: #FF8E1E;
color12: #1E8EFF;
color13: #8E1EFF;
color14: #1EFF8E;
color15: #C2C2C2;


}

